package kokkos
package kokkos newton on neigh half
# Equilibration for G-042
# Generated: seed=333333, Q=0.42, N_chains=18

units           real
dimension       3
boundary        p p f
atom_style      full
comm_style      brick
newton          off

bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2

pair_style      lj/class2/coul/long 12.0
special_bonds   lj/coul 0.0 0.0 1.0
pair_modify mix sixthpower

kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0

neighbor        2.0 bin
neigh_modify every 1 delay 0 check yes one 10000 page 1000000

variable v index 0.0001 0.00025 0.0005 0.001
variable i loop 4
label smd_loop
  include in.smd
clear
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton on neigh half

units           real
dimension       3
boundary        p p f
atom_style      full
comm_style      brick
newton          off

bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2

pair_style      lj/class2/coul/long 12.0
special_bonds   lj/coul 0.0 0.0 1.0
pair_modify     mix sixthpower

kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 10000 page 1000000

read_restart    system_equilibrated_G-042.restart
Reading restart file ...
  restart file = 22 Jul 2025, LAMMPS = 22 Jul 2025
  restoring atom style full/kk from restart
  orthogonal box = (0 0 -2) to (80.6296 82.864 200)
