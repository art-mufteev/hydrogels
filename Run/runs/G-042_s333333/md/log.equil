region          lower block INF INF INF INF -2 10 units box
group           lower region lower
4697 atoms in group lower
fix             FREEZE lower setforce 0.0 0.0 0.0
velocity        lower set 0.0 0.0 0.0
group           mobile subtract all lower
95112 atoms in group mobile
group           substrate_atoms subtract mobile solvent
45013 atoms in group substrate_atoms
group           excluded_types type 1 2 3 4 5 6 7 8
61811 atoms in group excluded_types
group           polymer subtract all excluded_types
37998 atoms in group polymer
region          pull_zone block INF INF INF INF 65.0 165.0 units box
group           atoms_in_zone region pull_zone
60652 atoms in group atoms_in_zone
group           pull_layer intersect polymer atoms_in_zone
18636 atoms in group pull_layer
group           substrate_atoms_types type 1 2 3 4
11712 atoms in group substrate_atoms_types
group           gel_atoms subtract all substrate_atoms_types
88097 atoms in group gel_atoms
#-
group           interface subtract all water ions
49710 atoms in group interface
compute         pe_atom_eq all pe/atom
compute         stress_eq all stress/atom NULL
compute         contacts_eq polymer coord/atom cutoff 3.5 group substrate_atoms
compute         water_eq polymer coord/atom cutoff 3.5 group water
compute         E_pair_eq gel_atoms group/group substrate_atoms_types kspace no pair yes
compute         pol_rg_eq     polymer gyration
compute         pol_msd_eq    polymer msd
compute         T_mobile      mobile temp
compute         contacts_sum_eq polymer reduce sum c_contacts_eq
compute         water_sum_eq  polymer reduce sum c_water_eq

compute  rdf_poly_glass  polymer rdf 200 * 1-4 cutoff 12.0
compute  rdf_water_glass water   rdf 200 * 1-4 cutoff 12.0
compute  rdf_poly_poly   polymer rdf 200 * *   cutoff 12.0
compute  rdf_poly_water  polymer rdf 200 * 5-6 cutoff 12.0
compute  rdf_ions_poly   ions    rdf 200 * 9-* cutoff 12.0
compute  rdf_ions_water  ions    rdf 200 * 5-6 cutoff 12.0

fix rdf_poly_out all ave/time 1000 10 10000     c_rdf_poly_glass[*] c_rdf_poly_poly[*] c_rdf_poly_water[*]     file rdf_polymer_struct_G-042_333333.txt mode vector
fix rdf_env_out all ave/time 1000 10 10000     c_rdf_water_glass[*] c_rdf_ions_poly[*] c_rdf_ions_water[*]     file rdf_environment_struct_G-042_333333.txt mode vector

compute  rho_poly  polymer chunk/atom bin/1d z lower 0.5 units box
compute  rho_water water   chunk/atom bin/1d z lower 0.5 units box
compute  rho_ions  ions    chunk/atom bin/1d z lower 0.5 units box
fix dens_poly  polymer ave/chunk 100 100 10000 rho_poly  density/number     file density_poly_G-042_333333.txt
fix dens_water water   ave/chunk 100 100 10000 rho_water density/number     file density_water_G-042_333333.txt
fix dens_ions  ions    ave/chunk 100 100 10000 rho_ions  density/number     file density_ions_G-042_333333.txt

variable T_mobile_v   equal c_T_mobile
variable E_int        equal ebond+eangle+edihed+eimp
variable E_pair_eq_v  equal c_E_pair_eq
variable tot_cnt_eq   equal c_contacts_sum_eq
variable wat_cnt_eq   equal c_water_sum_eq
variable poly_z_eq    equal xcm(polymer,z)
variable sub_z_eq     equal xcm(substrate_atoms_types,z)
variable gap_z_eq     equal v_poly_z_eq - v_sub_z_eq
variable rg_eq        equal c_pol_rg_eq
variable msd_x_eq     equal c_pol_msd_eq[1]
variable msd_y_eq     equal c_pol_msd_eq[2]
variable msd_z_eq     equal c_pol_msd_eq[3]
variable msd_xy_eq    equal (c_pol_msd_eq[1] + c_pol_msd_eq[2])

fix equil_txt_out all print 500   "$(step) $(time) $(temp) ${T_mobile_v} $(pe) $(ke) $(etotal)    $(press) $(pxx) $(pyy) $(pzz)    $(evdwl) $(ecoul) $(elong)    $(ebond) $(eangle) $(edihed) $(eimp)    ${E_int} ${E_pair_eq_v} ${tot_cnt_eq} ${wat_cnt_eq}    ${poly_z_eq} ${sub_z_eq} ${gap_z_eq}    ${rg_eq} ${msd_xy_eq} ${msd_z_eq} $(density)"   file metrics_equil_G-042_333333.txt screen no   title "Step Time Temp Temp_mobile PotEng KinEng TotEng Press Pxx Pyy Pzz Evdwl Ecoul Elong Ebond Eangle Edihed Eimp E_Internal E_Interface_Pair N_Contacts N_Water Polymer_Z Substrate_Z Gap_Z Rg MSD_xy MSD_z Density"

dump            equil_dense_dump all custom 50000 dump_equil_G-042_333333.lammpstrj.gz                 id type x y z ix iy iz q fx fy fz c_pe_atom_eq                 c_stress_eq[1] c_stress_eq[2] c_stress_eq[3]                 c_stress_eq[4] c_stress_eq[5] c_stress_eq[6]                 c_contacts_eq c_water_eq

#-
dump            1 all custom 400000 trajectory_equil_G-042_333333.lammpstrj.gz id type x y z ix iy iz

fix WALL_TOP solvent wall/harmonic zhi 157.0 10.0 0.0 2.0

min_modify dmax 0.1
min_style cg/kk
minimize 1.0e-4 1.0e-5 5000 50000
