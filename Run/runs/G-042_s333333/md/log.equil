#-
group           interface subtract all water ions
49710 atoms in group interface
compute         pe_atom_eq all pe/atom
compute         stress_eq all stress/atom NULL
compute         contacts_eq polymer coord/atom cutoff 3.5 group substrate_atoms
compute         water_eq polymer coord/atom cutoff 3.5 group water
compute         E_pair_eq gel_atoms group/group substrate_atoms_types kspace no pair yes

variable        E_pair_eq   equal c_E_pair_eq
compute         contacts_sum_eq polymer reduce sum c_contacts_eq
variable        tot_cnt_eq  equal c_contacts_sum_eq
variable        poly_z_eq  equal xcm(polymer,z)

dump            equil_dense_dump all custom 2000 dump_equil_G42.lammpstrj.gz                 id type x y z ix iy iz q fx fy fz c_pe_atom_eq                 c_stress_eq[1] c_stress_eq[2] c_stress_eq[3]                 c_stress_eq[4] c_stress_eq[5] c_stress_eq[6]                 c_contacts_eq c_water_eq
fix             equil_txt_out all print 500                 "$(step) $(time) $(temp) $(pe) $(press) ${E_pair_eq} ${tot_cnt_eq} ${poly_z_eq}"                 file metrics_equil_G42.txt screen no                 title "Step Time Temp PotEng Press E_Interface_Pair N_Interface_Contacts Polymer_Z_CM"
#-
dump            1 all custom 40000 trajectory_equil_G-042.lammpstrj.gz id type xu yu zu

fix WALL_TOP solvent wall/harmonic zhi 157.0 10.0 0.0 2.0

min_modify dmax 0.1
min_style cg/kk
minimize 1.0e-4 1.0e-5 5000 50000
