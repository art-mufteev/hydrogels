(* EMC: Script *)

(* define variables *)

variables	= {
  seed		-> {{ seed }},
  ntotal	-> 10000,
  fshape	-> 1,
  output	-> "setup",
  field		-> "cff/pcff/pcff",
  location1	-> "~/Apps/EMC/field/",

  nav		-> 0.6022141179,
  temperature	-> 300,
  radius	-> 3.5,
  nrelax	-> 4000,
  weight_nonbond -> 0.0001,
  weight_bond	-> 0.0001,
  weight_focus	-> 1,
  cutoff	-> 12,
  charge_cutoff	-> 12,
  kappa		-> 1,

  density1	-> 1,
  lprevious	-> 0,
  lphase	-> 0,

  f_Gmax	-> {{ N_chains }},

{% for m in monomers %}
  chem_{{ m.short|lower }}	-> "{{ m.emc_chemistry }}",
{% endfor %}
  chem_t	-> "*C"
};

output		= {
  debug		-> false,
  exit		-> true,
  info		-> true,
  warning	-> true
};

(* define force field *)

field		= {
  id		-> cff/pcff/pcff,
  mode		-> cff,
    name	-> {location1+field+".frc", location1+field+"_templates.dat"},
  compress	-> false
};

(* define groups *)

groups		= {
{% for m in monomers %}
  group		-> {
    id		-> {{ m.short|lower }}, depth -> 8, chemistry -> chem_{{ m.short|lower }},
    connects	-> {
{% for m2 in monomers %}
      {source	-> $end1, destination -> { {{- m2.short|lower }}, $end2}},
{% endfor %}
      {source	-> $end1, destination -> {t, $end1}},
{% for m2 in monomers %}
      {source	-> $end2, destination -> { {{- m2.short|lower }}, $end1}},
{% endfor %}
      {source	-> $end2, destination -> {t, $end1}}
    }
  },
{% endfor %}
  group		-> {
    id		-> t, depth -> 8, chemistry -> chem_t,
    connects	-> {
{% for m in monomers %}
      {source	-> $end1, destination -> { {{- m.short|lower }}, $end1}},
      {source	-> $end1, destination -> { {{- m.short|lower }}, $end2}}{% if not loop.last %},{% endif %}
{% endfor %}
    }
  }
};

field		= {
  mode		-> apply,
  check		-> {
    atomistic	-> true,
    charge	-> true
  },
  debug		-> false
};

(* determine simulation sizing *)

variables	= {

  (* lengths *)

{% for m in monomers %}
  lg_{{ m.short|lower }}	-> nsites({{ m.short|lower }}),
{% endfor %}
  lg_t		-> nsites(t),
  norm_Gmax	-> 1,

  l_Gmax	-> ({% for m in monomers %}{{ m.nrepeat }}*lg_{{ m.short|lower }}+{% endfor %}2*lg_t)*1/norm_Gmax,

  (* masses *)

{% for m in monomers %}
  mg_{{ m.short|lower }}	-> mass({{ m.short|lower }}),
{% endfor %}
  mg_t		-> mass(t),

  norm_Gmax	-> 1,

  m_Gmax	-> ({% for m in monomers %}{{ m.nrepeat }}*mg_{{ m.short|lower }}+{% endfor %}2*mg_t)*1/norm_Gmax,


  (* sizing *)

  n_Gmax	-> f_Gmax,


  (* system sizing *)

  ntotal	-> 0,
  mtotal	-> 0
};

(* define interactions *)

simulation	= {
  units		-> {
    permittivity -> 1,
    seed	-> seed
  },
  types		-> {
    coulomb	-> {
      pair	-> {active -> true, cutoff -> charge_cutoff}
    }
  }
};

(* clusters phase 1 *)

clusters	= {
  progress	-> none,
  polymer	-> {
    id		-> Gmax, system -> main, type -> random,
    n		-> int(1*n_Gmax/norm_Gmax+0.5),
    groups	-> {{ '{' }}{% for m in monomers %}{{ m.short|lower }}{% if not loop.last %}, {% endif %}{% endfor %}, t{{ '}' }},
    weights	-> {{ '{' }}{% for m in monomers %}1{% if not loop.last %}, {% endif %}{% endfor %}, 1{{ '}' }},
    nrepeat	-> {{ '{' }}{% for m in monomers %}{{ m.nrepeat }}{% if not loop.last %}, {% endif %}{% endfor %}, 2{{ '}' }}
  }
};

field		= {
  mode		-> apply,
  check		-> {
    atomistic	-> true,
    charge	-> false
  },
  debug		-> false
};

(* build phase 1 *)

types		= {
  cff		-> {
    pair	-> {active -> true, mode -> repulsive}
  }
};

variables	= {
  nphase1	-> ntotal()-ntotal,
  mphase1	-> mtotal()-mtotal,
  vphase1	-> mphase1/nav/density1,
  lbox		-> (vphase1/fshape)^(1/3),
  lphase1	-> fshape*lbox,
  lxx		-> {{ Lx }},
  lyy		-> {{ Ly }},
  lzz		-> {{ lzz }},
  lzy		-> 0,
  lzx		-> 0,
  lyx		-> 0,
  lphase	-> {{ Lx }},
  ntotal	-> nphase1,
  mtotal	-> mphase1,
  vtotal	-> {{ lzz }}*{{ Ly }}*{{ Lx }}
};

build		= {
  system	-> {
    id		-> main,
    split	-> false,
    geometry	-> {xx -> lxx, yy -> lyy, zz -> lzz,
		    zy -> lzy, zx -> lzx, yx -> lyx},
    temperature	-> temperature,
    flag	-> {charge -> false, geometry -> true, map -> true, pbc -> true}
  },
  select	-> {
    progress	-> list,
    frequency	-> 1,
    name	-> "error",
    order	-> random,
    cluster	-> {Gmax},
    relax	-> {ncycles -> nrelax, radius -> radius},
    grow	-> {
      method	-> energetic,
      check	-> all,
      nbonded	-> 15,
      ntrials	-> 300,
      niterations -> 5000,
      theta	-> 0,
      weight	-> {
	bonded	-> weight_bond, nonbonded -> weight_nonbond,
	focus	-> weight_focus}
    }
  }
};

force		= {style -> none, message -> nkt};
force		= {style -> init, message -> nkt};

(* LAMMPS profile variables *)

variables	= {
  nl_Gmax	-> nclusters(clusters -> Gmax)
};

(* storage *)

put		= {name -> output, compress -> true};

pdb		= {name -> output, compress -> true, extend -> false,
		   forcefield -> cff, detect -> false, hexadecimal -> false,
		   unwrap -> true, pbc -> true, atom -> index, residue -> index,
		   segment -> index, rank -> false, vdw -> false, cut -> false,
		   fixed -> true, rigid -> true, connectivity -> false,
		   parameters -> false};

lammps		= {name -> output, mode -> put, forcefield -> cff,
		   parameters -> true, types -> false, unwrap -> true,
		   charges -> true, ewald -> true};