(* EMC: Script *)

(* Created by emc_setup.pl v4.1.5, March 30, 2024
   on Mon Aug 03 20:03:14 MSK 2026 *)

(* define variables *)

variables	= {
  seed		-> -1,
  ntotal	-> 10000,
  fshape	-> 1,
  output	-> "setup",
  field		-> "cff/pcff/pcff",
  location1	-> "~/Apps/EMC/field/",

  nav		-> 0.6022141179,
  temperature	-> 300,
  radius	-> 5,
  nrelax	-> 100,
  weight_nonbond -> 0.0001,
  weight_bond	-> 0.0001,
  weight_focus	-> 1,
  cutoff	-> 12,
  charge_cutoff	-> 12,
  kappa		-> 4,

  density1	-> 3,
  lprevious	-> 0,
  lphase	-> 0,

  f_clsp	-> 15,

  chem_ba	-> "*CC(*)C(=O)OCCCC",
  chem_atac	-> "*CC(*)C(=O)OCC[N+](CC)(CC)CC",
  chem_sba	-> "*CC(*)C(=O)OC(C)CC",
  chem_bna	-> "*CC(*)C(=O)OCC1=CC=CC=C1",
  chem_t	-> "*C"
};

output		= {
  debug		-> false,
  exit		-> true,
  info		-> true,
  warning	-> true
};

(* define force field *)

field		= {
  id		-> cff/pcff/pcff,
  mode		-> cff,
    name	-> {location1+field+".frc", location1+field+"_templates.dat"},
  compress	-> false
};


(* define groups *)

groups		= {
  group		-> {
    id		-> ba, depth -> 8, chemistry -> chem_ba,
    connects	-> {
      {source	-> $end1, destination -> {atac, $end2}},
      {source	-> $end1, destination -> {ba, $end2}},
      {source	-> $end1, destination -> {bna, $end2}},
      {source	-> $end1, destination -> {sba, $end2}},
      {source	-> $end1, destination -> {t, $end1}},
      {source	-> $end2, destination -> {atac, $end1}},
      {source	-> $end2, destination -> {ba, $end1}},
      {source	-> $end2, destination -> {bna, $end1}},
      {source	-> $end2, destination -> {sba, $end1}},
      {source	-> $end2, destination -> {t, $end1}}
    }
  },
  group		-> {
    id		-> atac, depth -> 8, chemistry -> chem_atac,
    connects	-> {
      {source	-> $end1, destination -> {atac, $end2}},
      {source	-> $end1, destination -> {ba, $end2}},
      {source	-> $end1, destination -> {bna, $end2}},
      {source	-> $end1, destination -> {sba, $end2}},
      {source	-> $end1, destination -> {t, $end1}},
      {source	-> $end2, destination -> {atac, $end1}},
      {source	-> $end2, destination -> {ba, $end1}},
      {source	-> $end2, destination -> {bna, $end1}},
      {source	-> $end2, destination -> {sba, $end1}},
      {source	-> $end2, destination -> {t, $end1}}
    }
  },
  group		-> {
    id		-> sba, depth -> 8, chemistry -> chem_sba,
    connects	-> {
      {source	-> $end1, destination -> {atac, $end2}},
      {source	-> $end1, destination -> {ba, $end2}},
      {source	-> $end1, destination -> {bna, $end2}},
      {source	-> $end1, destination -> {sba, $end2}},
      {source	-> $end1, destination -> {t, $end1}},
      {source	-> $end2, destination -> {atac, $end1}},
      {source	-> $end2, destination -> {ba, $end1}},
      {source	-> $end2, destination -> {bna, $end1}},
      {source	-> $end2, destination -> {sba, $end1}},
      {source	-> $end2, destination -> {t, $end1}}
    }
  },
  group		-> {
    id		-> bna, depth -> 8, chemistry -> chem_bna,
    connects	-> {
      {source	-> $end1, destination -> {atac, $end2}},
      {source	-> $end1, destination -> {ba, $end2}},
      {source	-> $end1, destination -> {bna, $end2}},
      {source	-> $end1, destination -> {sba, $end2}},
      {source	-> $end1, destination -> {t, $end1}},
      {source	-> $end2, destination -> {atac, $end1}},
      {source	-> $end2, destination -> {ba, $end1}},
      {source	-> $end2, destination -> {bna, $end1}},
      {source	-> $end2, destination -> {sba, $end1}},
      {source	-> $end2, destination -> {t, $end1}}
    }
  },
  group		-> {
    id		-> t, depth -> 8, chemistry -> chem_t,
    connects	-> {
      {source	-> $end1, destination -> {atac, $end1}},
      {source	-> $end1, destination -> {atac, $end2}},
      {source	-> $end1, destination -> {ba, $end2}},
      {source	-> $end1, destination -> {ba, $end1}},
      {source	-> $end1, destination -> {bna, $end1}},
      {source	-> $end1, destination -> {bna, $end2}},
      {source	-> $end1, destination -> {sba, $end1}},
      {source	-> $end1, destination -> {sba, $end2}}
    }
  }
};

field		= {
  mode		-> apply,
  check		-> {
    atomistic	-> true,
    charge	-> false
  },
  debug		-> false
};

(* determine simulation sizing *)

variables	= {

  (* lengths *)

  lg_ba		-> nsites(ba),
  lg_atac	-> nsites(atac),
  lg_sba	-> nsites(sba),
  lg_bna	-> nsites(bna),
  lg_t		-> nsites(t),
  norm_clsp	-> 1,

  l_clsp	-> (48*lg_ba+8*lg_atac+18*lg_sba+27*lg_bna+2*lg_t)*1/norm_clsp,

  (* masses *)

  mg_ba		-> mass(ba),
  mg_atac	-> mass(atac),
  mg_sba	-> mass(sba),
  mg_bna	-> mass(bna),
  mg_t		-> mass(t),

  norm_clsp	-> 1,

  m_clsp	-> (48*mg_ba+8*mg_atac+18*mg_sba+27*mg_bna+2*mg_t)*1/norm_clsp,

  (* mol fractions *)

  f_clsp	-> f_clsp*l_clsp,

  (* normalization *)

  norm		-> f_clsp,

  f_clsp	-> f_clsp/norm,

  (* sizing *)

  n_clsp	-> 15,


  (* system sizing *)

  ntotal	-> 0,
  mtotal	-> 0
};

(* define interactions *)

simulation	= {
  units		-> {
    permittivity -> 1,
    seed	-> seed
  },
  types		-> {
    coulomb	-> {
      pair	-> {active -> true, cutoff -> charge_cutoff}
    }
  }
};

(* clusters phase 1 *)

clusters	= {
  progress	-> none,
  polymer	-> {
    id		-> clsp, system -> main, type -> random,
    n		-> int(1*n_clsp/norm_clsp+0.5),
    groups	-> {ba, atac, sba, bna, t},
    weights	-> {1, 1, 1, 1, 1},
    nrepeat	-> {48, 8, 18, 27, 2}
  }
};

field		= {
  mode		-> apply,
  check		-> {
    atomistic	-> true,
    charge	-> false
  },
  debug		-> false
};

(* build phase 1 *)

types		= {
  cff		-> {
    pair	-> {active -> true, mode -> repulsive}
  }
};

variables	= {
  nphase1	-> ntotal()-ntotal,
  mphase1	-> mtotal()-mtotal,
  vphase1	-> mphase1/nav/density1,
  lbox		-> (vphase1/fshape)^(1/3),
  lphase1	-> fshape*lbox,
  lxx		-> lphase1,
  lyy		-> lbox,
  lzz		-> lbox,
  lzy		-> 0,
  lzx		-> 0,
  lyx		-> 0,
  lphase	-> lphase1,
  ntotal	-> nphase1,
  mtotal	-> mphase1,
  vtotal	-> vphase1
};

build		= {
  system	-> {
    id		-> main,
    split	-> false,
    geometry	-> {xx -> lxx, yy -> lyy, zz -> lzz,
		    zy -> lzy, zx -> lzx, yx -> lyx},
    temperature	-> temperature,
    flag	-> {charge -> false, geometry -> true, map -> true, pbc -> true}
  },
  select	-> {
    progress	-> list,
    frequency	-> 1,
    name	-> "error",
    order	-> random,
    cluster	-> {clsp},
    relax	-> {ncycles -> nrelax, radius -> radius},
    grow	-> {
      method	-> energetic,
      check	-> all,
      nbonded	-> 20,
      ntrials	-> 20,
      niterations -> 1000,
      theta	-> 0,
      weight	-> {
	bonded	-> weight_bond, nonbonded -> weight_nonbond,
	focus	-> weight_focus}
    }
  }
};

force		= {style -> none, message -> nkt};
force		= {style -> init, message -> nkt};

(* LAMMPS profile variables *)

variables	= {
  nl_clsp	-> nclusters(clusters -> clsp)
};

(* storage *)

put		= {name -> output, compress -> true};

pdb		= {name -> output, compress -> true, extend -> false,
		   forcefield -> cff, detect -> false, hexadecimal -> false,
		   unwrap -> true, pbc -> true, atom -> index, residue -> index,
		   segment -> index, rank -> false, vdw -> false, cut -> false,
		   fixed -> true, rigid -> true, connectivity -> false,
		   parameters -> false};

lammps		= {name -> output, mode -> put, forcefield -> cff,
		   parameters -> true, types -> false, unwrap -> true,
		   charges -> true, ewald -> true};
