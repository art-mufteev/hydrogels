(* EMC: Script *)

(* define variables *)

variables	= {
  seed		-> 777888,
  ntotal	-> 10000,
  fshape	-> 1,
  output	-> "setup",
  field		-> "cff/pcff/pcff",
  location1	-> "~/Apps/EMC/field/",

  nav		-> 0.6022141179,
  temperature	-> 300,
  radius	-> 3.5,
  nrelax	-> 1000,
  weight_nonbond -> 0.0001,
  weight_bond	-> 0.0001,
  weight_focus	-> 1,
  cutoff	-> 12,
  charge_cutoff	-> 12,
  kappa		-> 1,

  density1	-> 0.7306895315591192,
  lprevious	-> 0,
  lphase	-> 0,

  f_R		-> 15,

  chem_ba	-> "*CC(*)C(=O)OCCCC",
  chem_atac	-> "*CC(*)C(=O)OCC[N+](C)(C)C",
  chem_pea	-> "*CC(*)C(=O)OCCOc1ccccc1",
  chem_t	-> "*C"
};

output		= {
  debug		-> false,
  exit		-> true,
  info		-> true,
  warning	-> true
};

(* define force field *)

field		= {
  id		-> cff/pcff/pcff,
  mode		-> cff,
    name	-> {location1+field+".frc", location1+field+"_templates.dat"},
  compress	-> false
};

(* define groups *)

groups		= {
  group		-> {
    id		-> ba, depth -> 8, chemistry -> chem_ba,
    connects	-> {
      {source	-> $end1, destination -> {atac, $end2}},
      {source	-> $end1, destination -> {ba, $end2}},
      {source	-> $end1, destination -> {pea, $end2}},
      {source	-> $end1, destination -> {t, $end1}},
      {source	-> $end2, destination -> {atac, $end1}},
      {source	-> $end2, destination -> {ba, $end1}},
      {source	-> $end2, destination -> {pea, $end1}},
      {source	-> $end2, destination -> {t, $end1}}
    }
  },
  group		-> {
    id		-> atac, depth -> 8, chemistry -> chem_atac,
    connects	-> {
      {source	-> $end1, destination -> {atac, $end2}},
      {source	-> $end1, destination -> {ba, $end2}},
      {source	-> $end1, destination -> {pea, $end2}},
      {source	-> $end1, destination -> {t, $end1}},
      {source	-> $end2, destination -> {atac, $end1}},
      {source	-> $end2, destination -> {ba, $end1}},
      {source	-> $end2, destination -> {pea, $end1}},
      {source	-> $end2, destination -> {t, $end1}}
    }
  },
  group		-> {
    id		-> pea, depth -> 8, chemistry -> chem_pea,
    connects	-> {
      {source	-> $end1, destination -> {atac, $end2}},
      {source	-> $end1, destination -> {ba, $end2}},
      {source	-> $end1, destination -> {pea, $end2}},
      {source	-> $end1, destination -> {t, $end1}},
      {source	-> $end2, destination -> {atac, $end1}},
      {source	-> $end2, destination -> {ba, $end1}},
      {source	-> $end2, destination -> {pea, $end1}},
      {source	-> $end2, destination -> {t, $end1}}
    }
  },
  group		-> {
    id		-> t, depth -> 8, chemistry -> chem_t,
    connects	-> {
      {source	-> $end1, destination -> {atac, $end1}},
      {source	-> $end1, destination -> {atac, $end2}},
      {source	-> $end1, destination -> {ba, $end2}},
      {source	-> $end1, destination -> {ba, $end1}},
      {source	-> $end1, destination -> {pea, $end1}},
      {source	-> $end1, destination -> {pea, $end2}}
    }
  }
};

field		= {
  mode		-> apply,
  check		-> {
    atomistic	-> true,
    charge	-> true
  },
  debug		-> false
};

(* determine simulation sizing *)

variables	= {

  (* lengths *)

  lg_ba		-> nsites(ba),
  lg_atac	-> nsites(atac),
  lg_pea	-> nsites(pea),
  lg_t		-> nsites(t),
  norm_R	-> 1,

  l_R		-> (59*lg_ba+10*lg_atac+32*lg_pea+2*lg_t)*1/norm_R,

  (* masses *)

  mg_ba		-> mass(ba),
  mg_atac	-> mass(atac),
  mg_pea	-> mass(pea),
  mg_t		-> mass(t),

  norm_R	-> 1,

  m_R		-> (59*mg_ba+10*mg_atac+32*mg_pea+2*mg_t)*1/norm_R,

  (* mol fractions *)

  f_R		-> f_R*l_R,

  (* normalization *)

  norm		-> f_R,

  f_R		-> f_R/norm,

  (* sizing *)

  n_R		-> int(f_R*ntotal/l_R+0.5),


  (* system sizing *)

  ntotal	-> 0,
  mtotal	-> 0
};

(* define interactions *)

simulation	= {
  units		-> {
    permittivity -> 1,
    seed	-> seed
  },
  types		-> {
    coulomb	-> {
      pair	-> {active -> true, cutoff -> charge_cutoff}
    }
  }
};

(* clusters phase 1 *)

clusters	= {
  progress	-> none,
  polymer	-> {
    id		-> R, system -> main, type -> random,
    n		-> 15,
    groups	-> {ba, atac, pea, t},
    weights	-> {1, 1, 1, 1},
    nrepeat	-> {59, 10, 32, 2}
  }
};

field		= {
  mode		-> apply,
  check		-> {
    atomistic	-> true,
    charge	-> false
  },
  debug		-> false
};

(* build phase 1 *)

types		= {
  cff		-> {
    pair	-> {active -> true, mode -> repulsive}
  }
};

variables	= {
  nphase1	-> ntotal()-ntotal,
  mphase1	-> mtotal()-mtotal,
  vphase1	-> mphase1/nav/density1,
  lbox		-> (vphase1/fshape)^(1/3),
  lphase1	-> fshape*lbox,
  lxx		-> 80.6296,
  lyy		-> 82.8640,
  lzz		-> 80,
  lzy		-> 0,
  lzx		-> 0,
  lyx		-> 0,
  lphase	-> 80.6296,
  ntotal	-> nphase1,
  mtotal	-> mphase1,
  vtotal	-> 80*82.8640*80.6296
};

build		= {
  system	-> {
    id		-> main,
    split	-> false,
    geometry	-> {xx -> lxx, yy -> lyy, zz -> lzz,
		    zy -> lzy, zx -> lzx, yx -> lyx},
    temperature	-> temperature,
    flag	-> {charge -> false, geometry -> true, map -> true, pbc -> true}
  },
  select	-> {
    progress	-> list,
    frequency	-> 1,
    name	-> "error",
    order	-> random,
    cluster	-> {R},
    relax	-> {ncycles -> nrelax, radius -> radius},
    grow	-> {
      method	-> energetic,
      check	-> all,
      nbonded	-> 15,
      ntrials	-> 200,
      niterations -> 3000,
      theta	-> 0,
      weight	-> {
	bonded	-> weight_bond, nonbonded -> weight_nonbond,
	focus	-> weight_focus}
    }
  }
};

force		= {style -> none, message -> nkt};
force		= {style -> init, message -> nkt};

(* LAMMPS profile variables *)

variables	= {
  nl_R		-> nclusters(clusters -> R)
};

(* storage *)

put		= {name -> output, compress -> true};

pdb		= {name -> output, compress -> true, extend -> false,
		   forcefield -> cff, detect -> false, hexadecimal -> false,
		   unwrap -> true, pbc -> true, atom -> index, residue -> index,
		   segment -> index, rank -> false, vdw -> false, cut -> false,
		   fixed -> true, rigid -> true, connectivity -> false,
		   parameters -> false};

lammps		= {name -> output, mode -> put, forcefield -> cff,
		   parameters -> true, types -> false, unwrap -> true,
		   charges -> true, ewald -> true};
