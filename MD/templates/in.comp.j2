units           real
atom_style      full
boundary        p p p
comm_style      brick
special_bonds   lj/coul 0.0 0.0 1.0
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
pair_style      lj/class2 12.0
read_data       setup.data
include         setup.params
pair_modify     mix sixthpower tail no
variable        ZHALF   equal {{ Z_film_half }}
variable        ZBOX    equal {{ Z_box_half }}
variable        NZBOX   equal "-v_ZBOX"
variable        NZHALF  equal "-v_ZHALF"
variable        SOFTCUT equal 5.0
variable        SOFTA   equal 60.0
variable        NPUSH   equal 500000
variable        NHOLD   equal 100000

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

pair_style      soft $(v_SOFTCUT)
comm_modify     cutoff 8.0
pair_coeff      * * $(v_SOFTA)
dump            TRJ all custom 10000 dump.soft.lammpstrj.gz id mol type q x y z

compute         ZMIN all reduce min z
compute         ZMAX all reduce max z
thermo_style    custom step temp press lz pe atoms c_ZMIN c_ZMAX
run             0 post no
variable        DZSHIFT equal "-(c_ZMIN+c_ZMAX)/2.0"
displace_atoms  all move 0.0 0.0 $(v_DZSHIFT) units box

change_box      all boundary p p f
run             0 post no

variable        ZB0 equal "c_ZMIN-5.0"
variable        ZT0 equal "c_ZMAX+5.0"
variable        ZB3 equal "c_ZMIN-3.0"
variable        ZT3 equal "c_ZMAX+3.0"

run 0

fix wall_b_0 all wall/harmonic zlo $(v_ZB3) 70 0.0 2.0 units box
fix wall_t_0 all wall/harmonic zhi $(v_ZT3) 70 0.0 2.0 units box

min_modify dmax 0.1
min_style cg
minimize 1.0e-4 1.0e-5 5000 50000
min_style cg
minimize 1.0e-8 1.0e-10 20000 200000


timestep        0.1
fix             1 all nve/limit 0.05
fix             2 all viscous 100.0
thermo          1000
run             30000
unfix           1
unfix           2

velocity        all zero linear
velocity        all zero angular

variable        ZB0F internal $(v_ZB0)
variable        ZT0F internal $(v_ZT0)
variable        z_bot equal "ramp(v_ZB0F,v_NZHALF)"
variable        z_top equal "ramp(v_ZT0F,v_ZHALF)"

# fix wall_b all wall/harmonic zlo v_z_bot 30 0.0 3.0 units box
# fix wall_t all wall/harmonic zhi v_z_top 30 0.0 3.0 units box

fix wall_b_r all wall/reflect zlo v_z_bot units box
fix wall_t_r all wall/reflect zhi v_z_top units box


fix             1 all langevin 300.0 300.0 100.0 48279
fix             2 all nve

variable film_dens equal "mass(all)/(0.6022141*lx*ly*(v_z_top-v_z_bot))"

thermo          2000
thermo_style    custom step temp press lz pe atoms c_ZMIN c_ZMAX v_film_dens
timestep        0.5
run             ${NPUSH}

unfix           wall_b
unfix           wall_t
fix             final_wall_b all wall/harmonic zlo -41.2 20 0.0 1.0 units box
fix             final_wall_t all wall/harmonic zhi 41.2 20 0.0 1.0 units box

fix             final_wall_b all wall/reflect zlo v_NZHALF units box
fix             final_wall_t all wall/reflect zhi v_ZHALF units box

velocity        all scale 300.0
run             ${NHOLD}
timestep        0.5
pair_style      lj/class2 12.0
pair_modify     mix sixthpower tail no
include         setup.params
pair_modify     tail no
kspace_style pppm 1.0e-4
kspace_modify   slab 3.0
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

unfix           1
unfix           2

min_style cg
minimize        1.0e-6 1.0e-8 10000 100000


change_box all z final {{ -Z_final_half }} {{ Z_final_half }}
write_data      Polymer_{{ name }}_{{ seed }}.data