# mpirun -np 6 lmp -sf pair/gpu -pk gpu 1 newton off -in in.run_smd_G42 or mpirun -np 1 lmp_kokkos_cuda -k on g 1 -sf kk -in in.run_smd_G42

units           real          
dimension       3
boundary        p p f         
atom_style      full     
comm_style      brick        
newton          off

bond_style      class2        
angle_style     class2        
dihedral_style  class2        
improper_style  class2

pair_style      lj/class2/coul/long 12.0
special_bonds   lj/coul 0.0 0.0 1.0  
pair_modify mix sixthpower

kspace_style    pppm 1.0e-4   
kspace_modify   slab 3.0

neighbor        2.0 bin
neigh_modify every 1 delay 0 check yes one 10000 page 1000000 

read_data       Silico_system.data &
                extra/atom/types 13 &
                extra/bond/types 17 &
                extra/angle/types 32 &
                extra/dihedral/types 45 &
                extra/improper/types 24 &
                extra/angle/per/atom 45 &
                extra/dihedral/per/atom 50 &
                extra/improper/per/atom 30
                
read_data	Polymer_G42.data add append shift 0.0 0.0 65.0 offset 8 4 6 4 3

molecule        water_mol water.mol

region          poly_zone block INF INF INF INF 25 105 units box
region          water_zone block INF INF INF INF 105 155 units box

create_atoms    7 random 2 11111 poly_zone  # Na+
create_atoms    7 random 31 11111 water_zone  # Na+
create_atoms    8 random 152 67890 poly_zone  # Cl-
create_atoms    8 random 31 67890 water_zone  # Cl-

create_atoms 0 random 6127 12345 poly_zone mol water_mol 98765 overlap 1.33
create_atoms 0 random 11111 12345 water_zone mol water_mol 98765 overlap 1.33

group solvent type 5 6 7 8
group ions    type 7 8
group water   type 5 6
set type 7 charge 1.0
set type 8 charge -1.0   


write_data      system_check_G42.data

region          lower block INF INF INF INF -2 10 units box
group           lower region lower
fix             FREEZE lower setforce 0.0 0.0 0.0
velocity        lower set 0.0 0.0 0.0
group           mobile subtract all lower
group           substrate_atoms subtract mobile solvent
group           excluded_types type 1 2 3 4 5 6 7 8
group		polymer subtract all excluded_types
region          pull_zone block INF INF INF INF 65.0 165.0 units box
group           atoms_in_zone region pull_zone
group           pull_layer intersect polymer atoms_in_zone

# Simulation ------------------------------------------------------------

dump            1 all custom 20000 trajectory_stabilization_G42.lammpstrj.gz id type xu yu zu

thermo		150
thermo_style custom step temp ebond eangle edihed eimp pe press

fix WALL_TOP solvent wall/harmonic zhi 157.0 10.0 0.0 2.0

min_modify dmax 0.1
min_style cg/kk
minimize 1.0e-4 1.0e-5 5000 50000
min_style cg/kk
minimize 1.0e-8 1.0e-10 20000 200000
set group mobile image 0 0 0

timestep        0.1
fix             1 mobile nve/limit 0.05
fix             2 mobile viscous 50.0
fix             3 all dt/reset 1 NULL 0.001 0.1
thermo          1000
run             10000
# fix_modify      1 energy yes
unfix           1
unfix           2
unfix           3

velocity        mobile zero linear
velocity        mobile zero angular

velocity        mobile create 10 12345 mom yes rot yes dist gaussian

timestep        0.1
fix             rNVT mobile nvt temp 10.0 10.0 50.0
thermo          500
run             10000  

timestep        0.25
run             10000 
timestep        0.5
run             10000 

fix PRESS pull_layer spring tether 15 NULL NULL 0 40
timestep        0.5
run             30000
unfix		PRESS
run             20000
unfix		rNVT

fix		tNVT mobile nvt temp 10.0 300.0 200.0

timestep	0.5
thermo		1000	
run		500000

unfix		tNVT

fix		fNVT mobile nvt temp 300.0 300.0 100.0

timestep	0.5
thermo		1000
run		1500000

# SAVE
undump		1

write_data      system_equilibrated_G42.data
write_restart   system_equilibrated_G42.restart

variable v index 0.0001 0.00025 0.0005 0.001
variable i loop 4
label smd_loop
 	
    include in.smd
    
    next v
    next i
    
    jump in.run_smd_G42 smd_loop

