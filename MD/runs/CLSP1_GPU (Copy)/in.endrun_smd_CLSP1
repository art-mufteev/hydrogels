#  mpirun -np 1 ./lmp_kokkos_cuda -k on g 1 -sf kk -pk kokkos newton off -in in.endrun_smd_CLSP1

units           real          
dimension       3
boundary        p p f         
atom_style      full     
comm_style      brick        
newton          off

bond_style      class2        
angle_style     class2        
dihedral_style  class2        
improper_style  class2

pair_style      lj/class2/coul/long 12.0
special_bonds   lj/coul 0.0 0.0 1.0  
pair_modify mix sixthpower

kspace_style    pppm 1.0e-5   
kspace_modify   slab 3.0

neighbor        2.0 bin
neigh_modify every 1 delay 0 check yes one 10000 page 1000000 

variable v index 0.00025 0.00001 0.0005 0.001
variable i loop 4
label smd_loop

    include in.smd
    
    next v
    next i
    
    jump in.endrun_smd_CLSP1 smd_loop
