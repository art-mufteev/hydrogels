clear
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton off

units           real
dimension       3
boundary        p p f
atom_style      full
comm_style      brick
newton          off

bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2

pair_style      lj/class2/coul/long 12.0
special_bonds   lj/coul 0.0 0.0 1.0
pair_modify mix sixthpower

kspace_style    pppm 1.0e-5
kspace_modify   slab 3.0

neighbor        2.0 bin
neigh_modify every 1 delay 0 check yes one 10000 page 1000000

read_restart    system_equilibrated_R1.restart
Reading restart file ...
  restart file = 22 Jul 2025, LAMMPS = 22 Jul 2025
  restoring atom style full/kk from restart
  orthogonal box = (0 0 -2) to (80.6296 82.864 218.5)
  1 by 1 by 1 MPI processor grid
  restoring pair style lj/class2/coul/long/kk from restart
  restoring bond style class2/kk from restart
  restoring angle style class2/kk from restart
  restoring dihedral style class2/kk from restart
  restoring improper style class2/kk from restart
  98877 atoms
  85120 bonds
  112058 angles
  135771 dihedrals
  52507 impropers
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        1       
  special bond factors coul:  0        0        1       
     4 = max # of 1-2 neighbors
    12 = max # of 1-3 neighbors
    16 = max # of special neighbors
  special bonds CPU = 0.048 seconds
  read_restart CPU = 0.111 seconds
newton          off
comm_style      brick
pair_modify     mix sixthpower
kspace_modify   slab 3.0
region          lower block INF INF INF INF -2 10 units box
group           lower region lower
4704 atoms in group lower
group           solvent type 5 6 7 8
51930 atoms in group solvent
group           ions    type 7 8
216 atoms in group ions
group           water   type 5 6
51714 atoms in group water
group           mobile subtract all lower
94173 atoms in group mobile
molecule        water_mol water.mol
Read molecule template water_mol:
# Water molecule. Original PCFF flexible geometry
  1 molecules
  0 fragments
  0 bodies
  3 atoms with max type 6
  2 bonds with max type 4
  1 angles with max type 6
  0 dihedrals with max type 0
  0 impropers with max type 0

variable        smd_steps equal round(350.0/v_v)
variable        print_freq equal round(v_smd_steps/1000)
variable        dump_freq  equal round(v_smd_steps/100)

fix             FREEZE lower setforce 0.0 0.0 0.0
velocity        lower set 0.0 0.0 0.0
group           excluded_types type 1 2 3 4 5 6 7 8
63642 atoms in group excluded_types
group		polymer subtract all excluded_types
35235 atoms in group polymer
region          pull_zone block INF INF INF INF 65.0 165.0 units box
group           atoms_in_zone region pull_zone
59391 atoms in group atoms_in_zone
group           pull_layer intersect polymer atoms_in_zone
20612 atoms in group pull_layer
group           smd_mobile subtract mobile pull_layer
73561 atoms in group smd_mobile
group           substrate_atoms type 1 2 3 4
46947 atoms in group substrate_atoms
group           gel_atoms subtract all substrate_atoms
51930 atoms in group gel_atoms
fix		sNVT smd_mobile nvt temp 300.0 300.0 50.0
fix             sNVE pull_layer nve

compute         pol_rg polymer gyration
compute         pol_rmsd polymer msd
compute		E_int gel_atoms group/group substrate_atoms
compute         T_layer pull_layer temp

variable        z_start equal xcm(pull_layer,z)
variable        z_target equal v_z_start+30.0

group2ndx index.ndx pull_layer lower
Writing groups to index file index.ndx:
 writing group pull_layer...done
 writing group lower...done

fix             pull all colvars none output colvars_out_${i}
fix             pull all colvars none output colvars_out_2
----------------------------------------------------------------------
Initializing the collective variables module, version 2025-04-30 (patch 1).
Please cite Fiorin et al, Mol Phys 2013:
  https://doi.org/10.1080/00268976.2013.813594
as well as all other papers listed below for individual features used.
Summary of compile-time features available in this build:
  - C++ language version: 201703
  - Multiple replicas: available, but not (yet) enabled
  - Lepton custom functions: available
  - Tcl interpreter: not available
Using LAMMPS interface, version "2025-03-31".
Setting initial step number from MD engine: 840811

fix_modify      pull config """
indexFile index.ndx
colvar {
  name distZ
  distanceZ {
    main {
      indexGroup pull_layer
    }
    ref {
      dummyAtom (0.0, 0.0, 0.0)
    }
    axis (0.0, 0.0, 1.0)
  }
  outputValue on
  outputVelocity on
  outputAppliedForce on
}
harmonic {
  name pulling
  colvars distZ
  centers ${z_start}
  targetCenters ${z_target}
  targetNumSteps ${smd_steps}
  forceConstant 6.0
  outputCenters on
  outputAccumulatedWork on
  outputEnergy on
}
"""

dump            smd_dump all custom ${dump_freq} trajectory_smd_R1_$i.lammpstrj id type xu yu zu q fx fy fz
dump            smd_dump all custom 7000 trajectory_smd_R1_$i.lammpstrj id type xu yu zu q fx fy fz
dump            smd_dump all custom 7000 trajectory_smd_R1_2.lammpstrj id type xu yu zu q fx fy fz

variable        E_bond     equal ebond
variable        E_angle    equal eangle
variable        E_dihed    equal edihed
variable        E_poly_int equal ebond+eangle+edihed
variable        rg         equal c_pol_rg
variable        rmsd       equal sqrt(c_pol_rmsd[1]+c_pol_rmsd[2])
variable        e_inter    equal c_E_int
variable        t_loc      equal c_T_layer

fix             smd_output all print ${print_freq} "$(step) $(v_rg) $(v_rmsd) $(v_e_inter) $(v_E_poly_int) $(v_t_loc)" file adhesion_data_R1_$i.txt screen no title "Step Rg RMSD_XY E_Interface E_Poly_Internal T_Local"
fix             smd_output all print 700 "$(step) $(v_rg) $(v_rmsd) $(v_e_inter) $(v_E_poly_int) $(v_t_loc)" file adhesion_data_R1_$i.txt screen no title "Step Rg RMSD_XY E_Interface E_Poly_Internal T_Local"
fix             smd_output all print 700 "$(step) $(v_rg) $(v_rmsd) $(v_e_inter) $(v_E_poly_int) $(v_t_loc)" file adhesion_data_R1_2.txt screen no title "Step Rg RMSD_XY E_Interface E_Poly_Internal T_Local"

thermo          1000
thermo_style    custom step temp c_E_int pe
timestep        0.25
run             ${smd_steps}
run             700000

