fix_modify      pull config """
indexFile index.ndx
colvar {
  name distZ
  distanceZ {
    main {
      indexGroup pull_layer
    }
    ref {
      dummyAtom (0.0, 0.0, 0.0)
    }
    axis (0.0, 0.0, 1.0)
  }
  outputValue on
  outputVelocity on
  outputAppliedForce on
}
harmonic {
  name pulling
  colvars distZ
  centers ${z_start}
  targetCenters ${z_target}
  targetNumSteps ${smd_steps}
  forceConstant 6.0
  outputCenters on
  outputAccumulatedWork on
  outputEnergy on
}
"""

dump            smd_dump all custom ${dump_freq} trajectory_smd_R1_$i.lammpstrj id type xu yu zu q fx fy fz
dump            smd_dump all custom 3500 trajectory_smd_R1_$i.lammpstrj id type xu yu zu q fx fy fz
dump            smd_dump all custom 3500 trajectory_smd_R1_1.lammpstrj id type xu yu zu q fx fy fz

variable        E_bond     equal ebond
variable        E_angle    equal eangle
variable        E_dihed    equal edihed
variable        E_poly_int equal ebond+eangle+edihed
variable        rg         equal c_pol_rg
variable        rmsd       equal sqrt(c_pol_rmsd[1]+c_pol_rmsd[2])
variable        e_inter    equal c_E_int
variable        t_loc      equal c_T_layer

fix             smd_output all print ${print_freq} "$(step) $(v_rg) $(v_rmsd) $(v_e_inter) $(v_E_poly_int) $(v_t_loc)" file adhesion_data_R1_$i.txt screen no title "Step Rg RMSD_XY E_Interface E_Poly_Internal T_Local"
fix             smd_output all print 350 "$(step) $(v_rg) $(v_rmsd) $(v_e_inter) $(v_E_poly_int) $(v_t_loc)" file adhesion_data_R1_$i.txt screen no title "Step Rg RMSD_XY E_Interface E_Poly_Internal T_Local"
fix             smd_output all print 350 "$(step) $(v_rg) $(v_rmsd) $(v_e_inter) $(v_E_poly_int) $(v_t_loc)" file adhesion_data_R1_1.txt screen no title "Step Rg RMSD_XY E_Interface E_Poly_Internal T_Local"

thermo          1000
thermo_style    custom step temp c_E_int pe
timestep        0.25
run             ${smd_steps}
run             350000
