# silica_Q3_amorph_4_7OH_0pct_ion.lammps05

units           real          
dimension       3
boundary        p p f         
atom_style      full          
comm_style      tiled         

bond_style      class2        
angle_style     class2        
dihedral_style  class2        
improper_style  class2

pair_style      lj/class2/coul/long/gpu 10.0 12.0
kspace_style    pppm 1.0e-5  
kspace_modify   slab 3.0      
pair_modify     mix sixthpower 
neigh_modify one 10000 page 100000



read_data       silica_Q3_amorph_4_7OH_0pct_ion.lammps05

replicate 2 2 1 bond/periodic



special_bonds   lj/coul 0.0 0.0 1.0  


region lower block INF INF INF INF -2 10 units box
group lower region lower

fix freeze lower setforce 0.0 0.0 0.0

group mobile subtract all lower

reset_atoms image all


minimize        1.0e-4 1.0e-6 10000 100000
reset_timestep  0


thermo          1000
thermo_style    custom step temp press vol density pe ke etotal enthalpy

dump            1 all custom 5000 trajectory_Sil.lammpstrj id type q x y z

timestep        1.0           

fix             STEP_NVT mobile nvt temp 298.15 298.15 100.0
run             50000         
unfix           STEP_NVT


write_data      Silico_system_no_params.data 
write_restart system_equilibrated_Si_0.restart
