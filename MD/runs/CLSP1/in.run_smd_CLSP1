# mpirun -np 1 ./lmp_kokkos_cuda -k on g 1 t 6 -sf kk -pk kokkos newton off -in in.run_smd_CLSP1

units           real          
dimension       3
boundary        p p f         
atom_style      full     
comm_style      brick        
newton          off

bond_style      class2        
angle_style     class2        
dihedral_style  class2        
improper_style  class2

pair_style      lj/class2/coul/long 12.0
special_bonds   lj/coul 0.0 0.0 1.0  
pair_modify mix sixthpower

kspace_style    pppm 1.0e-5   
kspace_modify   slab 3.0

neighbor        2.0 bin
neigh_modify every 1 delay 0 check yes one 10000 page 1000000 

read_data       Silico_system.data &
                extra/atom/types 8 &
                extra/bond/types 13 &
                extra/angle/types 27 &
                extra/dihedral/types 41 &
                extra/improper/types 23 &
                extra/angle/per/atom 23 &
                extra/dihedral/per/atom 41 &
                extra/improper/per/atom 41
                
read_data	Polymer_CLSP1.data add append shift 0.0 0.0 66.5 offset 8 4 6 4 3

molecule        water_mol water.mol

region          poly_zone block INF INF INF INF 25 105 units box
region          water_zone block INF INF INF INF 105 155 units box

create_atoms    7 random 3 51111 poly_zone  # Na+
create_atoms    7 random 31 51111 water_zone  # Na+
create_atoms    8 random 120 27890 poly_zone  # Cl-
create_atoms    8 random 31 27890 water_zone  # Cl-

create_atoms 0 random 6644 52345 poly_zone mol water_mol 98765 overlap 1.33
create_atoms 0 random 11111 52345 water_zone mol water_mol 98765 overlap 1.33

group solvent type 5 6 7 8
group ions    type 7 8
group water   type 5 6
set type 7 charge 1.0
set type 8 charge -1.0   


write_data      system_check_CLSP1.data

region          lower block INF INF INF INF -2 10 units box
group           lower region lower
fix             FREEZE lower setforce 0.0 0.0 0.0
velocity        lower set 0.0 0.0 0.0
group           mobile subtract all lower
group           substrate_atoms subtract mobile solvent

# Simulation ------------------------------------------------------------

dump            1 all custom 5000 trajectory_stabilization_CLSP1.lammpstrj id type q xu yu zu

thermo		150
thermo_style custom step temp ebond eangle edihed eimp pe press

fix WALL_TOP solvent wall/harmonic zhi 157.0 10.0 0.0 2.0

min_modify dmax 0.1
min_style cg/kk
minimize 1.0e-4 1.0e-5 5000 50000
min_style cg/kk
minimize 1.0e-8 1.0e-10 20000 200000
set group mobile image 0 0 0

timestep        0.1
fix             1 mobile nve/limit 0.05
fix             2 mobile viscous 50.0
fix             3 all dt/reset 1 NULL 0.001 0.1
thermo          1000
run             10000
# fix_modify      1 energy yes
unfix           1
unfix           2
unfix           3

velocity        mobile zero linear
velocity        mobile zero angular

velocity        mobile create 10 52345 mom yes rot yes dist gaussian

timestep        0.1
fix             rNVT mobile nvt temp 10.0 10.0 50.0
thermo          500
run             10000  

timestep        0.25
run             10000 
timestep        0.5
run             10000 
unfix		rNVT

fix		tNVT mobile nvt temp 10.0 300.0 200.0

timestep	0.5
thermo		1000	
run		400000

unfix		tNVT

fix		fNVT mobile nvt temp 300.0 300.0 100.0

timestep	0.5
thermo		1000
run		400000

# SAVE
undump		1

write_data      system_equilibrated_CLSP1.data
write_restart   system_equilibrated_CLSP1.restart

variable v index 0.00025 0.0001 0.0005 0.001
variable i loop 4
label smd_loop

    include in.smd
    
    next v
    next i
    
    jump in.master smd_loop
